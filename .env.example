# Optional OpenAI-compatible endpoint (must include /v1).
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama
# Qwen3 on Ollama: disable thinking for task extraction; allow cold model loading.
# LLM_REASONING_EFFORT=none
# LLM_TIMEOUT_SECONDS=90
# Keep requests to local services out of system proxies.
# NO_PROXY=localhost,127.0.0.1,::1
# DATABASE_URL=sqlite:///./flowpilot.db
